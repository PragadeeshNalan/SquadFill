{
  "name": "squadfill-e2e-automation",
  "version": "1.0.0",
  "description": "Enterprise E2E Selenium Framework for SquadFill React Application",
  "main": "index.js",
  "scripts": {
    "test": "mocha --timeout 120000 --reporter mochawesome --reporter-options reportDir=reports,reportFilename=e2e_report tests/**/*.spec.js",
    "test:chrome": "cross-env BROWSER=chrome npm test",
    "test:firefox": "cross-env BROWSER=firefox npm test",
    "test:headless": "cross-env HEADLESS=true npm test",
    "generate-excel": "node utilities/excelReporter.js",
    "posttest": "node utilities/excelReporter.js"
  },
  "devDependencies": {
    "selenium-webdriver": "^4.15.0",
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "exceljs": "^4.4.0",
    "mochawesome": "^7.1.3",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "cross-env": "^7.0.3",
    "fs-extra": "^11.1.1"
  }
}